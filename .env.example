# Copy to .env (never commit .env). Real values only in .env or GitHub secrets.
OPENROUTER_API_KEY=
# Only needed if LM Studio isn't at http://localhost:1234/v1
LMSTUDIO_BASE_URL=
# owner/name of this repo; auto-detected from the git origin when blank
FLEET_REPO=
# Optional: a token with Discussions access if you don't use `gh auth login`
FLEET_GITHUB_TOKEN=
# Airtable base that holds the fleet's switches (see README, "Switches in Airtable").
# Token scopes: data.records:read, data.records:write, schema.bases:read, schema.bases:write.
# Base ID is the "app..." part of the base URL. Then run: node runner/fleet.mjs settings init
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appOadUGGPnSY5rzZ
